# Create an API key at https://resend.com/api-keys
RESEND_API_KEY=

# From Google Search Console: choose the "HTML tag" method and paste only the
# value inside content="...". Leave empty until you have one.
GOOGLE_SITE_VERIFICATION=wU8duO6v9Jskn7ikRYABXKssMvZtd-NA6meXewNdGRI

# From Google Tag Manager, for example GTM-XXXXXXX. Leave empty to turn it off.
NEXT_PUBLIC_GTM_ID=GTM-MTTCN9VT

# Where the blog posts come from: the Laravel admin panel, without a trailing slash.
BLOG_API_URL=http://localhost:8000

# A long random string. Must match FRONTEND_REVALIDATE_SECRET in the admin panel's .env,
# so it can refresh the blog as soon as a post is published.
REVALIDATE_SECRET=
